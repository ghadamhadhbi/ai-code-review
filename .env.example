# =======================
# AI Code Review Environment Variables
# =======================

# OpenAI Configuration (REQUIRED)
OPENAI_API_KEY=your-openai-api-key-here

# Groq Configuration (REQUIRED)
GROQ_API_KEY=your-groq-api-key-here
GROQ_KEY_NAME=StudentProjectKey

# Git Webhook Secrets
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
GITLAB_WEBHOOK_SECRET=your-gitlab-webhook-secret

# Notification Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Database Configuration (Used by Docker Compose)
POSTGRES_DB=code_review
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123

# Development URLs (Optional - defaults provided)
DATABASE_URL=postgresql://admin:password123@localhost:5432/code_review
REDIS_URL=redis://localhost:6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Frontend Configuration - IMPORTANT: Must match backend port
REACT_APP_API_URL=http://localhost:8003
# WebSocket will be constructed from API_URL automatically